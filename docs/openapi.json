{
  "components": {
    "schemas": {
      "DocumentBatch": {
        "properties": {
          "documents": {
            "items": {
              "$ref": "#/components/schemas/DocumentIn"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Documents",
            "type": "array"
          }
        },
        "required": [
          "documents"
        ],
        "title": "DocumentBatch",
        "type": "object"
      },
      "DocumentIn": {
        "properties": {
          "id": {
            "pattern": "^[A-Za-z0-9._:@-]{1,256}$",
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "title": {
            "default": "",
            "maxLength": 1000,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "title": "DocumentIn",
        "type": "object"
      },
      "DocumentView": {
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "embedded": {
            "title": "Embedded",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "metadata",
          "chunks",
          "embedded"
        ],
        "title": "DocumentView",
        "type": "object"
      },
      "DocumentWritten": {
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "reused_embeddings": {
            "title": "Reused Embeddings",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "chunks",
          "reused_embeddings",
          "unchanged"
        ],
        "title": "DocumentWritten",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HitView": {
        "properties": {
          "document_id": {
            "title": "Document Id",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "ordinal": {
            "title": "Ordinal",
            "type": "integer"
          },
          "ranks": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ranks"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "snippet": {
            "description": "Plain text with matches between \u00ab and \u00bb. Escape it before rendering as HTML.",
            "title": "Snippet",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "ordinal",
          "title",
          "snippet",
          "metadata",
          "score"
        ],
        "title": "HitView",
        "type": "object"
      },
      "Mode": {
        "enum": [
          "hybrid",
          "lexical",
          "vector"
        ],
        "type": "string"
      },
      "SearchRequest": {
        "properties": {
          "explain": {
            "default": false,
            "description": "Include each hit's rank in each retriever",
            "title": "Explain",
            "type": "boolean"
          },
          "filter": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "JSON containment on document metadata",
            "title": "Filter"
          },
          "k": {
            "default": 10,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "K",
            "type": "integer"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode",
            "default": "hybrid"
          },
          "query": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "hits": {
            "items": {
              "$ref": "#/components/schemas/HitView"
            },
            "title": "Hits",
            "type": "array"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "took_ms": {
            "title": "Took Ms",
            "type": "number"
          }
        },
        "required": [
          "mode",
          "took_ms",
          "hits"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "Stats": {
        "properties": {
          "chunks": {
            "title": "Chunks",
            "type": "integer"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "pending": {
            "title": "Pending",
            "type": "integer"
          }
        },
        "required": [
          "documents",
          "chunks",
          "pending"
        ],
        "title": "Stats",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
